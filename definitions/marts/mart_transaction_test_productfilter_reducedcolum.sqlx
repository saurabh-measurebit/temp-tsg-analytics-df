config { type: "table" ,
  bigquery: {
    partitionBy:  "transaction_date"
  }
}

/*Reduce Columns for Master Transaction Table - All Revenue Calculate*/
select
  transaction_date,
  transaction_id,
  transaction_type,
  transaction_amount,
  Transaction_fee,
  product_name,
  product_category
  
from ${ref('mart_transaction_test_productfilter')}
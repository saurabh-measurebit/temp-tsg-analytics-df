------------------------------------------------------------
-- Combine Samcart tables to gether to associate order,
-- charges, and UTMs (from customers), together
------------------------------------------------------------

config { type: "view" }

with

-- Samcart charges
sc_charges as (
    select
        charge_date as transaction_date,
        charge_dt as transaction_dt,
        transaction_id,
        charge_id,
        charge_type as transaction_type,
        charge_amount as transaction_amount,
        sam_customer_id,
        processor_name as merchant,
        samcart_account
    from ${ref('stg_samcart_charge')}
),

-- Samcart orders
sc_orders as (
    select
        transaction_id,
        utm_source,
        utm_medium,
        utm_campaign,
        product_name, 
        order_date,
        samcart_account
    from ${ref('stg_samcart_order')}
),

-- Samcart customers
sc_customers as (
    select
        sam_customer_id,
        email as customer_email,
        samcart_account
    from ${ref('stg_samcart_customer')}  
),

-- Get Samcart source and email 
sc_joined as (
    select
        transaction_date,
        transaction_dt,
        cast(transaction_id as string) as transaction_id,	
        charge_id,
        transaction_type,
        case
            when transaction_type = 'refund' and transaction_amount > 0 then transaction_amount
            else transaction_amount
        end as transaction_amount,
        product_name,
        customer_email,
        merchant,
        utm_source,
        utm_medium,
        utm_campaign,
        'samcart' as cart,
        t1.samcart_account
    from sc_charges                                                t1
    left join sc_orders using(transaction_id, samcart_account)
    left join sc_customers using(sam_customer_id, samcart_account)
)

select *
from sc_joined
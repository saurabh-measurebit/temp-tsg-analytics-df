---------------------------------------------------
-- Query combines subscriptions (py_) from Samcart
-- with charges (ch_) from Stripe.

-- Stripe charges endpoint does not contain py_
-- So we get them from Samcart.
-- Stripe is working to fix this. Recheck later.
---------------------------------------------------

config { type: "view" }


select
    charge_id,
    email, 
    t1.samcart_account
from ${ref('stg_samcart_charge')}         t1
left join ${ref('stg_samcart_customer')}  t2
using (sam_customer_id, samcart_account)
where charge_id like 'py_%' 

union all

select 
    charge_id,
    email,
    'unknown' as samcart_account
from ${ref('stg_stripe_charge')}          t1
left join  ${ref('stg_stripe_customer')}  t2
using (stripe_customer_id)
where
    charge_id like "ch_%"
    and charge_status = true
-------------------------------------------
-- Query gets utms of Stripe charges
-- from Checkout Champ
-------------------------------------------

config { type: "view" }

with 

-- Stripe charges
stg_stripe_charges as   (
    select 
        transaction_id,
        charge_id 
    from ${ref('stg_stripe_charge')}  
    where transaction_id is not null
),

-- utm source from Checkout Champ orders
joined as (
    select 
        order_date,
        order_amount,
        charge_id,
        transaction_id,
        utm_source,
        utm_medium,
        utm_campaign,
        utm_content,
        utm_term,
        t2.shipCountry,
        case when t1.transaction_id = t2.transaction_id then 'checkout champ' end as cart
    from stg_stripe_charges                       t1
    left join ${ref('stg_checkoutchamp_orders')}  t2  
    using (transaction_id)
)

select *
from joined



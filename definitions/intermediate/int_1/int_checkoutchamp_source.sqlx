-------------------------------------------
-- Query gets utms of Stripe charges
-- from Checkout Champ
-------------------------------------------

config { type: "view" }

with 

-- Stripe charges
stg_stripe_charges as   (
    select 
        client_order_id,
        charge_id 
    from ${ref('stg_stripe_charge')}  
    where client_order_id is not null
)

-- utm source from Checkout Champ
select 
    charge_id,
    utm_source,
    utm_medium,
    utm_campaign,
    utm_content,
    utm_term
from stg_stripe_charges
left join ${ref('stg_checkoutchamp_orders')}    
using (client_order_id)


-------------------------------------------------------------
-- Paypal transactions, joined with orders to get utms
-------------------------------------------------------------

config { type: "view" }

with

-- Checkout Champ paypal transactions
cc_transactions as (
    select
        transaction_date,
        transaction_id,
        charge_id,
        transaction_type,
        transaction_amount,
        -- transaction_fee,
        product_name,
        customer_email,
        'paypal' as merchant
    from ${ref('stg_checkoutchamp_transactions')}  
    where lower(merchant) like '%paypal%'
),

-- Checkout Champ orders
cc_orders as (
    select
        client_order_id,
        utm_source,
        utm_medium,
        utm_campaign
    from ${ref('stg_checkoutchamp_orders')}
),

-- Get Checkout Champ source
cc_joined as (
    select
        * except(client_order_id),
        'checkout champ' as cart
    from cc_transactions    t1
    left join cc_orders     t2
    on t1.transaction_id = t2.client_order_id
),

-- Samcart paypal charges
sc as (
    select
        transaction_date,
        transaction_id,	
        charge_id,
        transaction_type,
        transaction_amount,
        product_name,
        customer_email,
        merchant,
        utm_source,
        utm_medium,
        utm_campaign,
        cart
    from ${ref('int_samcart')} 
    where merchant = 'paypal'
),

unioned as (
    select * from cc_joined
    union all
    select * from sc
)

select *
from unioned
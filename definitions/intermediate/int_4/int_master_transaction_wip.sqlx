---------------------------------------------------------
-- Work in progress. Update Stripe google ads UTMs
---------------------------------------------------------

config { type: "table" ,
    bigquery: {
        partitionBy:  "transaction_date"
    }
}

with

-- Google ads utm_campaign contains campaign id.Campaign name corrected.
gad_campaign_corrected as (
  select 
    transaction_date,
    transaction_dt,
    transaction_id,
    charge_id,
    transaction_type,
    transaction_amount,
    transaction_fee,
    product_name,
    customer_email,
    product_category,
    utm_source,
    utm_medium,
    coalesce(t2.campaign_name, t1.utm_campaign) as utm_campaign,
    utm_content,
    utm_term,
    merchant,
    cart,
    samcart_account
  from ${ref('int_master_transaction')}   t1
  left join (
    select campaign_id, max(campaign_name) campaign_name
    from ${ref('stg_gad')} 
  group by campaign_id)                   t2
  on t1.utm_campaign = t2.campaign_id
)


select *
from gad_campaign_corrected

-- ${when(incremental(), `where transaction_date >= (select max(transaction_date) from ${self()})`) }
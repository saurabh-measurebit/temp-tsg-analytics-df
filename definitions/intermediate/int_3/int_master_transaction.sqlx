---------------------------------------------------------
-- Query combines transactions from Stripe and Paypal
---------------------------------------------------------

config { type: "table" ,
    bigquery: {
        partitionBy:  "transaction_date"
    }
}

with

-- Stripe transactions
stripe_merchant as (
  select 
    transaction_date,
    transaction_dt,
    transaction_id,
    charge_id,
    transaction_type,
    transaction_amount,
    transaction_fee,
    product_name,
    customer_email,
    utm_source,
    utm_medium,
    utm_campaign,
    utm_content,
    utm_term,
    cart,
    merchant,
    samcart_account
  from ${ref('int_stripe_trans')}
),

-- Paypal transactions
paypal_merchant as (
  select
    transaction_date,
    transaction_dt,
    transaction_id,
    charge_id,
    transaction_type,
    transaction_amount,
    cast(null as numeric) as transaction_fee,
    product_name,
    customer_email,
    utm_source,
    utm_medium,
    utm_campaign,
    utm_content,
    utm_term,
    cart,
    merchant,
    samcart_account
  from ${ref('int_paypal_trans')}
),

-- Comine Stripe and Paypal transactions
merchants_combined as (
    select *
    from paypal_merchant
    union all
    select *
    from stripe_merchant
),

-- Categorize transactions by product_name rules
categorized as (
  select
    transaction_date,
    transaction_dt,
    transaction_id,
    charge_id,
    transaction_type,
    transaction_amount,
    transaction_fee,
    product_name,
    customer_email,
    case
      when regexp_contains(lower(ifnull(product_name,"")),r"founding member.*|.*all access.*|.*trial.*all access.*|.*trial all access.*|quick start package.*|all access membership.*|.*special offer.*20 minute shallowing fix.*|.*all access.*bonus|null|^[ ]$|^78$|^43$|^75$|^62$|^136$|^77$|^150$|^83$|^101$|^142$|^135$|^1$|^79$|^44$|^2$|^65$|^42$|^33$|$1 membership|^$|aa membership|147") and not (regexp_contains(lower(ifnull(product_name,"")),r"reviews")) then "All Access Membership"
      when regexp_contains(lower(ifnull(product_name,"")),r"distance masterclass|20 minute distance fix.*") then "20 Minute Distance Fix"
      when (not (regexp_contains(lower(ifnull(product_name,"")),r"all access|in person"))   
        and regexp_contains(lower(ifnull(product_name,"")),r"20-minute shallowing fix|20 minute shallowing fix|20msf live payment|20 msf \\(\\$10\\)|134")) then "20 Minute Shallowing Fix"
      when regexp_contains(lower(ifnull(product_name,"")),r"ball striking masterclass.*|ball striking master class") then "Ball Striking Masterclass"
      when regexp_contains(lower(ifnull(product_name,"")),r"quick start report$|152|quick start") then "Quick Start Report"
      when (regexp_contains(lower(ifnull(product_name,"")),r"unlimited online reviews|monthly (unlimited )?online swing reviews|monthly online unlimited swing reviews|rocket fuel swing reviews|rocket fuel swing reviews w/ robin rosado|110|114|121|94|123|108|112|monthly unlimited online lessons with clay ballard|rocket fuel|unlimited swing reviews|reviews") and not (regexp_contains(lower(ifnull(product_name,"")),r"swing plate.*")) ) then "Unlimited Swing Reviews"
      when regexp_contains(lower(ifnull(product_name,"")),r".*in-person lesson with.*|.*in person.*|2 day.*with robin rosado.*|.*in-person.*") then "In Person Lesson"
      when regexp_contains(lower(ifnull(product_name,"")),r"tsg distance golf clinic.*|distance clinic.*") then "Clinic"
      when (regexp_contains(lower(ifnull(product_name,"")),r"swing plate|swing plate, base model, no alignment rods|swing plate with alignment rods and foam protector") or regexp_contains(lower(ifnull(product_name,"")),r"(?i)divot board|precision impact|check point swing laser|b1 blue strike.*|c3i|45° square strike wedge")) then "Training Aids"
      when regexp_contains(lower(ifnull(product_name,"")),r"inside the ropes with clay(?: ballard)?") then "Inside the Ropes"
      when regexp_contains(lower(ifnull(product_name,"")),r"double your lag in 30 minutes") then "Swing Courses"
      when regexp_contains(lower(ifnull(product_name,"")),r"repayment for disputed charge") then "Disputes" 
      when regexp_contains(lower(ifnull(product_name,"")),r"minute posture fix") then "Posture" 
      when regexp_contains(lower(ifnull(product_name,"")),r"ball-then-turf masterclass|btmc") then "Ball-Then-Turf Mastercass"
      when regexp_contains(lower(ifnull(product_name,"")),r"b29 blue brick") then "ShotCraft"  
      else "Other"
    end as product_category,
    utm_source,
    utm_medium,
    utm_campaign,
    utm_content,
    utm_term,
    cart,
    merchant,
    samcart_account
  from merchants_combined
),

-- Filter out test transactions
remove_tests as (
select *
from categorized
where
  not((regexp_contains(ifnull(customer_email,""),r"(?i)testingtest.com")
    or regexp_contains(ifnull(customer_email,""),r"(?i)measurebit.com")
    or regexp_contains(ifnull(customer_email,""),r"(?i)samcart.com")
    or regexp_contains(ifnull(customer_email,""),r"(?i)testinator.com")
    or regexp_contains(ifnull(customer_email,""),r"(?i)mailinator.com")
    or regexp_contains(ifnull(customer_email,""),r"(?i)topspeedgolf.com")
    or regexp_contains(ifnull(customer_email,""),r"(?i)aboundup.com")
    or regexp_contains(ifnull(customer_email,""),r"(?i)davidroconnell.com")
    or regexp_contains(ifnull(customer_email,""),r"(?i)measurementmarketing.io")
    or regexp_contains(ifnull(customer_email,""),r"(?i)tomitrader.com")) )
  and not((regexp_contains(lower(ifnull(product_name,"")),r"(?i)purchase from top speed golf")
    or regexp_contains(lower(ifnull(product_name,"")),r"(?i)1 day renewal product 2")
    or regexp_contains(lower(ifnull(product_name,"")),r"(?i)fake shippable good")
    or regexp_contains(lower(ifnull(product_name,"")),r"(?i)test trial")
    or regexp_contains(lower(ifnull(product_name,"")),r"(?i)test product")
    or regexp_contains(lower(ifnull(product_name,"")),r"(?i)taxjar test")
    or regexp_contains(lower(ifnull(product_name,"")),r"(?i)tsg level 1 instructor test")) )
)

select *
from remove_tests
-- where customer_email = 'domalley64@yahoo.com' -- for the purposes of debugging

-- ${when(incremental(), `where transaction_date >= (select max(transaction_date) from ${self()})`) }
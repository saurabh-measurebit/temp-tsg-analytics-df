------------------------------------------------------------
-- Stripe subscriptions lack product name. Stripe invoices
-- lack charge_id. We combine both subscriptions with
-- charge_id and product_name. Query creates a list of 
-- charges and subscriptions with product name. 
------------------------------------------------------------

config { type: "view" }

with

-- Stripe charges
charges as (
  select
    charge_id,
    case
      when lower(description) like 'payment for order# %' then 'All Access Membership'
      when lower(description) like 'order # %, %' and product_name is not null then product_name
      when lower(description) like 'order # %, [0-9]+' then regexp_extract(description, r'order # \d+, (.+)$')
      when not lower(description) like 'order # %' and product_name is null then 'CC - ' || description
      when lower(description) like '%, %' then regexp_extract(description, r', (.+)$')
      else null
    end as product_name
  from ${ref('stg_stripe_charge')}
  where
    lower(description) not like "invoice%"
),

-- Stripe charges lack subscription product_name
stripe_charge_invoice as (
  select
    charge_date,
    charge_id,
    invoice_id
  from ${ref('stg_stripe_charge')}
  where
    lower(description) like "invoice%"
),

-- Stripe invoices lack charge_id
stripe_invoice as (
  select
    invoice_date,
    invoice_id,
    product_name,
    charge_id
  from ${ref('stg_stripe_invoice')}
),

-- Combine Stripe charge subscriptions with invoices
-- to get both charge_id and product name
invoices as (
  select
    charge_date,
    charge_id,
    invoice_date,
    t1.invoice_id,
    product_name
  from stripe_charge_invoice    t1
  left join stripe_invoice      t2
  using (charge_id)
)

-- Recombine charges with subscriptions that have product_name
select
  charge_id,
  product_name
from charges
union all
select
  charge_id,
  product_name
from invoices

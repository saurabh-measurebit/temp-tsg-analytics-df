config { type: "view" }

-- Add product name to base master transaction table

with

balance_trans as (
  select
    transaction_date,
    transaction_id,
    transaction_type,
    amount,
    fee,
    charge_id,
    product_name
  from
   ${ref('stg_balancetransaction_startingtable')}  
),

balance_trans_ch as (
  select *
  from balance_trans
  where regexp_contains(ifnull(charge_id,""),r"(?i)ch_")
),

charge_product_name as (
  select
    charge_id,
    product_name
  from
   ${ref('int_productname')}     

),

abc as (
  select
    transaction_date,
    transaction_id,
    transaction_type,
    amount,
    fee,
    charge_id,
    t2.product_name as product_name
  from balance_trans_ch t1
  left join charge_product_name t2
  using(charge_id)

),

balance_trans_py as (
  select *
  from balance_trans
  where regexp_contains(ifnull(charge_id,""), r"(?i)py_")
),

balance_trans_not_ch_py as (
  select *
  from balance_trans
  where not((regexp_contains(ifnull(charge_id,""), r"(?i)py_") or regexp_contains(ifnull(charge_id,""),r"(?i)ch_")) )
),

xyz as (
  select * from balance_trans_py
  union all
  select * from balance_trans_not_ch_py
),

abc_xyz as (
  select * from abc
  union all
  select * from xyz
)

select
    transaction_date,
    transaction_id,
    transaction_type,
    amount,
    fee,
    product_name,
    case
        when regexp_contains(lower(ifnull(product_name,"")),r"distance masterclass|20 minute distance fix.*") then "20 Minute Distance Fix"
        when (not (regexp_contains(lower(ifnull(product_name,"")),r"all access"))
              and regexp_contains(lower(ifnull(product_name,"")),r"20-minute shallowing fix|20 minute shallowing fix|20msf live payment|20 msf \\(\\$10\\)|134")) 
              then "20 Minute Shallowing Fix"
        when regexp_contains(lower(ifnull(product_name,"")),r"quick start report$|152|quick start") then "Quick Start Report"
        when regexp_contains(lower(ifnull(product_name,"")),r"ball striking masterclass.*|ball striking master class") then "Ball Striking Masterclass"
        when (regexp_contains(lower(ifnull(product_name,"")),r"unlimited online reviews|monthly (unlimited )?online swing reviews|monthly online unlimited swing reviews|rocket fuel swing reviews|rocket fuel swing reviews w/ robin rosado|110|114|121|94|123|108|112|monthly unlimited online lessons with clay ballard|rocket fuel") and not (regexp_contains(lower(ifnull(product_name,"")),r"swing plate.*")) ) then "Unlimited Swing Reviews"
        when regexp_contains(lower(ifnull(product_name,"")),r".*in-person lesson with.*|.*in person.*|2 day.*with robin rosado.*|.*in-person.*") then "In Person Lesson"
        when regexp_contains(lower(ifnull(product_name,"")),r"tsg distance golf clinic.*|distance clinic.*") then "Clinic"
        when regexp_contains(lower(ifnull(product_name,"")),r"founding member.*|.*all access.*|.*trial.*all access.*|.*trial all access.*|quick start package.*|all access membership.*|.*special offer.*20 minute shallowing fix.*|.*all access.*bonus|null|^[ ]$|^78$|^43$|^75$|^62$|^136$|^77$|^150$|^83$|^101$|^142$|^135$|^1$|^79$|^44$|^2$|^65$|^42$|^33$|$1 membership|^$") then "All Access Membership"
        when (regexp_contains(lower(ifnull(product_name,"")),r"swing plate, base model, no alignment rods|swing plate with alignment rods and foam protector") or regexp_contains(lower(ifnull(product_name,"")),r"(?i)divot board|precision impact|check point swing laser|b1 blue strike.*|c3i")) then "Training Aids"
        when regexp_contains(lower(ifnull(product_name,"")),r"inside the ropes with clay(?: ballard)?") then "Inside the Ropes"
        when regexp_contains(lower(ifnull(product_name,"")),r"double your lag in 30 minutes") then "Swing Courses"
    else
    "Other"
end as product_category,
    charge_id,
from abc_xyz
